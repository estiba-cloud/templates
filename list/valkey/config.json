{
  "$schema": "../../schema.json",
  "name": "Valkey",
  "description": "In-memory key-value store compatible with Redis, saved to disk.",
  "category": "database",
  "url": "https://valkey.io",
  "author": "https://github.com/valkey-io",
  "inputs": [
    {
      "name": "PASSWORD",
      "label": "Password",
      "generate": true
    }
  ],
  "service": {
    "image": "valkey/valkey:9",
    "secrets": {
      "VALKEY_EXTRA_FLAGS": "--requirepass ${PASSWORD} --appendonly yes"
    },
    "ports": [
      {
        "port": 6379,
        "protocol": "tcp"
      }
    ],
    "volumes": [
      {
        "folder": "data",
        "path": "/data"
      }
    ],
    "grace": 60
  }
}
